pkgname=nvmon
pkgver=0.1.0
pkgrel=1
pkgdesc='Watch an NVIDIA GPU: temperature, fan, power, and PCIe link'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'nvidia-utils')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/nvmon "$pkgdir/usr/bin/nvmon"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/nvmon.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/nvmon.svg"
  install -Dm644 "$startdir/nvmon.desktop" "$pkgdir/usr/share/applications/nvmon.desktop"
}
